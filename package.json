{
  "name": "agroxarita",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd backend && .venv\\Scripts\\python.exe manage.py runserver 8000",
    "dev:web": "npm --prefix frontend run dev",
    "setup": "npm install && npm --prefix frontend install",
    "test": "cd backend && .venv\\Scripts\\python.exe -m pytest -q",
    "check": "npm --prefix frontend run lint && npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
