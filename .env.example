# Serverda /opt/agroxarita/.env sifatida nusxa oling va to'ldiring (git'ga kirmaydi).

# --- Django ---
SECRET_KEY=almashtiring-uzun-tasodifiy-satr
DEBUG=False
ALLOWED_HOSTS=agroxarita.example.uz
CSRF_TRUSTED_ORIGINS=https://agroxarita.example.uz
CORS_ALLOWED_ORIGINS=https://agroxarita.example.uz
USE_X_FORWARDED_HOST=True
COOKIE_SECURE=True
TILE_CACHE_MAX_AGE=3600
TILE_STATIK_MAX_AGE=86400
LOG_LEVEL=WARNING

# --- Baza (db konteyneri shu qiymatlar bilan yaratiladi) ---
DB_NAME=agroxarita
DB_USER=agroxarita
DB_PASSWORD=almashtiring

# PostgreSQL xotira (server RAM ga moslang: shared_buffers ~25%, effective_cache ~75%)
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE=6GB
PG_WORK_MEM=64MB
PG_MAINTENANCE_WORK_MEM=1GB
REDIS_MAXMEMORY=1gb

# --- Gunicorn ---
GUNICORN_WORKERS=5
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# --- Copernicus CDS (iqlimni yangilash uchun) ---
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# --- Docker ---
REGISTRY_IMAGE=registry.dev.digitagro.uz/gis/agro-xarita
TAG=latest
DATA_PATH=/opt/agroxarita/data
BACKUP_PATH=/opt/agroxarita/backups
HTTP_BIND=127.0.0.1:8080
