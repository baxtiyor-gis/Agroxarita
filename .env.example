# Serverda repo ildizida .env sifatida nusxa oling va to'ldiring (git'ga kirmaydi).

# --- Django ---
SECRET_KEY=almashtiring-uzun-tasodifiy-satr
DEBUG=False
ALLOWED_HOSTS=agroxarita.example.uz
CSRF_TRUSTED_ORIGINS=https://agroxarita.example.uz
CORS_ALLOWED_ORIGINS=https://agroxarita.example.uz
USE_X_FORWARDED_HOST=True
COOKIE_SECURE=True
TILE_CACHE_MAX_AGE=3600
TILE_STATIK_MAX_AGE=86400
LOG_LEVEL=WARNING

# --- Baza (db konteyneri shu qiymatlar bilan yaratiladi) ---
DB_NAME=agroxarita
DB_USER=agroxarita
DB_PASSWORD=almashtiring

# PostgreSQL xotira (umumiy server: konteyner chegaralari docker-compose.yml da — DB_MEM, BACKEND_MEM)
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE=3GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=512MB
REDIS_MAXMEMORY=512mb

# --- Gunicorn ---
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# --- Copernicus CDS (iqlimni yangilash uchun) ---
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# --- Docker (REGISTRY_IMAGE=agroxarita — serverda build; HTTP_BIND — bo'sh localhost porti) ---
REGISTRY_IMAGE=agroxarita
TAG=latest
DATA_PATH=./data
BACKUP_PATH=./backups
HTTP_BIND=127.0.0.1:8090
# backend konteyneri foydalanuvchisi uid — data/ papkasi egasi (id -u), /data ga yozish uchun
AGRO_UID=10001
